{
  "appId": "com.jackbhai.surbox",
  "appName": "SurBox",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#000000",
    "keepRunning": true,
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#000000",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
